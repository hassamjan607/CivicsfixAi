# Database setup
DATABASE_URL = "sqlite:///civicfix.db"
engine = create_engine(DATABASE_URL, echo=False)

# Request/Response models
class ChatRequest(BaseModel):
    message: str = Field(..., min_length=1, max_length=1000)
    session_id: Optional[str] = None
    latitude: Optional[float] = Field(None, ge=-90, le=90)
    longitude: Optional[float] = Field(None, ge=-180, le=180)
    anonymous: bool = False

class ChatResponse(BaseModel):
    response: str
    tracking_id: Optional[str] = None
    status: str
    needs_clarification: bool = False
    error: Optional[str] = None

class ComplaintSubmitRequest(BaseModel):
    category: Optional[str] = None
    description: str = Field(..., min_length=1, max_length=2000)
    latitude: Optional[float] = Field(None, ge=-90, le=90)
    longitude: Optional[float] = Field(None, ge=-180, le=180)
    citizen_name: Optional[str] = Field(None, max_length=100)
    citizen_phone: Optional[str] = Field(None, max_length=20)
    citizen_email: Optional[str] = Field(None, max_length=100)
    anonymous: bool = False

class ComplaintResponse(BaseModel):
    tracking_id: str
    status: str
    category: str
    summary: str
    urgency_score: int
    urgency_reasons: List[str]
    department: str
    created_at: datetime
    estimated_resolution: Optional[datetime] = None

class StatusUpdateRequest(BaseModel):
    status: ComplaintStatus
    notes: Optional[str] = Field(None, max_length=500)

# Database session dependency
def get_session():
    with Session(engine) as session:
        yield session


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan manager for startup and shutdown tasks"""
    
    # Startup tasks
    print("🚀 Starting CivicFix AI...")
    
    # Run complete database initialization
    await run_database_initialization(engine, "data")
    
    # Check initialization status
    init_status = is_database_initialized(engine)
    print("📊 Database initialization status:", init_status)
    
    # Show database statistics
    db_stats = get_database_stats(engine)
    print("📈 Database contents:", db_stats)
    
    # Initialize RAG service (will be implemented in later tasks)
    # await index_documents_if_needed(DATABASE_URL, "data/")
    print("📚 RAG service initialization deferred to later tasks")
    
    # Start SLA monitoring scheduler (will be enabled in later tasks)
    # scheduler.add_job(
    #     check_sla_breaches,
    #     IntervalTrigger(minutes=15),
    #     id="sla_monitor",
    #     name="SLA Breach Monitor"
    # )
    # scheduler.start()
    print("⏰ SLA monitoring scheduler deferred to later tasks")
    
    print("✅ CivicFix AI startup complete")
    
    yield
    
    # Shutdown tasks
    print("🛑 Shutting down CivicFix AI...")
    # scheduler.shutdown()
    print("⏰ Scheduler stopped")


app = FastAPI(
    title="CivicFix AI",
    description="AI-powered municipal complaint platform with voice-first interaction",
    version="1.0.0",
    lifespan=lifespan
)

# Add CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # Configure appropriately for production
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

